# TechVerse — environment variables
# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local, .env, or any file containing real secrets.

# ------------------------------------------------------------------
# Site
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_EVENT_DATE="18 October 2026"
NEXT_PUBLIC_SHORT_DATE="Oct 18"
NEXT_PUBLIC_FULL_DATE="Oct 18, 2026"
NEXT_PUBLIC_COPYRIGHT_HOLDER=TechVerse
NEXT_PUBLIC_TWITTER_USER_NAME=
NEXT_PUBLIC_REPO_URL=https://github.com/A-verse/TechVerse
NEXT_PUBLIC_CODE_OF_CONDUCT_URL=
NEXT_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_DISCORD_URL=

# ------------------------------------------------------------------
# Supabase (user accounts / tickets)
# ------------------------------------------------------------------
SUPABASE_URL=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_SECRET=

# ------------------------------------------------------------------
# DatoCMS (stages, speakers, sessions, sponsors content)
# ------------------------------------------------------------------
DATOCMS_READ_ONLY_API_TOKEN=

# ------------------------------------------------------------------
# hCaptcha (registration form)
# ------------------------------------------------------------------
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
# Server-only. Leave both hCaptcha vars unset to disable captcha locally.
HCAPTCHA_SECRET_KEY=

# ------------------------------------------------------------------
# GitHub OAuth (optional account linking, used for the ticket image flow)
# ------------------------------------------------------------------
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
GITHUB_OAUTH_CLIENT_SECRET=

# ------------------------------------------------------------------
# Misc server-only secrets
# ------------------------------------------------------------------
# Used to derive a stable, non-guessable user id from an email address.
EMAIL_TO_ID_SECRET=

# ------------------------------------------------------------------
# LiveKit (live stages)
# ------------------------------------------------------------------
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Comma-separated list of email addresses allowed to join as moderator.
# This is the ONLY source of moderator authorization — never trust a
# client-supplied role.
LIVEKIT_MODERATOR_EMAILS=

# Room names for the three live stages. Must match the rooms configured
# in your LiveKit project; the token endpoint rejects any room not in
# this allowlist.
NEXT_PUBLIC_LIVEKIT_ROOM_A=techverse-live-stage
NEXT_PUBLIC_LIVEKIT_ROOM_C=techverse-engineering-stage
NEXT_PUBLIC_LIVEKIT_ROOM_M=techverse-community-stage

# Optional per-stage external Discord links, shown only if set.
NEXT_PUBLIC_LIVE_STAGE_DISCORD_A=
NEXT_PUBLIC_LIVE_STAGE_DISCORD_C=
NEXT_PUBLIC_LIVE_STAGE_DISCORD_M=

# ------------------------------------------------------------------
# Sample sponsor data (public/, demo/fallback content only — see
# lib/sample-data.ts. Leave blank to hide the corresponding buttons
# rather than rendering a fake/placeholder URL.)
# ------------------------------------------------------------------
NEXT_PUBLIC_VERTEX_LABS_URL=
NEXT_PUBLIC_VERTEX_LABS_DISCORD=
NEXT_PUBLIC_VERTEX_LABS_JOBS_URL=
NEXT_PUBLIC_VERTEX_LABS_JOBS_DISCORD=
NEXT_PUBLIC_NOVA_SYSTEMS_URL=
NEXT_PUBLIC_NOVA_SYSTEMS_DISCORD=
NEXT_PUBLIC_NOVA_SYSTEMS_JOBS_URL=
NEXT_PUBLIC_NOVA_SYSTEMS_JOBS_DISCORD=
NEXT_PUBLIC_TECHVERSE_JOBS_URL=
NEXT_PUBLIC_TECHVERSE_JOBS_DISCORD=
